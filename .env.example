# ===== 服务 =====
# 宿主机监听地址与端口（默认仅本机；直接对外访问请改为 0.0.0.0）
BIND_ADDR=127.0.0.1
APP_PORT=3000
TZ=Asia/Shanghai

# ===== 构建加速（仅 docker compose build 时使用，国内服务器访问慢时设置）=====
# npm 源，例如 https://registry.npmmirror.com；留空使用默认源
NPM_REGISTRY=
# 基础镜像地址，Docker Hub 无法访问时可改为你的镜像加速/私有仓库中的同版本镜像，
# 例如 docker.m.daocloud.io/library/node:24.21.0-bookworm-slim。留空使用 compose 中的默认值
# NODE_IMAGE=

# ===== 访问保护（强烈建议设置）=====
# 设置后访问页面与接口都需要登录；留空则不启用
APP_PASSWORD=
# 会话签名密钥，留空则由 APP_PASSWORD 派生；建议设置为随机长字符串（openssl rand -hex 32）
SESSION_SECRET=
# 通过 HTTPS 访问时设为 true，Cookie 将带 Secure 标记
COOKIE_SECURE=false

# ===== 业务默认值 =====
# 周起始日默认值：0=周日，1=周一 … 6=周六。在页面里修改后以页面设置为准
WEEK_START=1

# ===== 大模型（沿用 pi-ai 约定，详见 README“大模型配置”）=====
# 指定使用的模型；留空则取 pi-config/settings.json 的 defaultProvider / defaultModel，
# 再没有则取第一个已配置密钥的模型
LLM_PROVIDER=
LLM_MODEL=
# 单次调用超时（毫秒，1000~600000）与单次汇总输入上限（字符）
LLM_TIMEOUT_MS=120000
LLM_MAX_INPUT_CHARS=60000

# ===== 模型密钥（pi-ai 内置 provider 的环境变量，按需填写其一）=====
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# 自定义端点（pi-config/models.json 中用 $MY_API_KEY 引用）
# MY_API_KEY=
